# Copy this file to .kamal/secrets and source values from your password manager
# or local environment. Never commit real credentials.
RAILS_MASTER_KEY=
OPENAI_ACCESS_TOKEN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_ENDPOINT=
HOSTS=

# Generate a long random value shared only by Rails and Alloy.
METRICS_BEARER_TOKEN=

# Copy these values from the Grafana Cloud "Send metrics/logs" configuration.
# OBSERVABILITY_WRITE_TOKEN needs metrics:write and logs:write scopes only.
METRICS_WRITE_URL=
METRICS_USERNAME=
LOGS_WRITE_URL=
LOGS_USERNAME=
OBSERVABILITY_WRITE_TOKEN=

# Add this and configure registry credentials in config/deploy.yml when using
# an authenticated registry.
KAMAL_REGISTRY_PASSWORD=
