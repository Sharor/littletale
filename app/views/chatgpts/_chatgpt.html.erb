<div id="<%= dom_id chatgpt %>">
  <p>
    <strong>Prompt:</strong>
    <%= chatgpt.prompt %>
  </p>

  <p>
    <strong>Answer:</strong>
    <%= chatgpt.answer %>
  </p>

  <p>
    <strong>Max tokens:</strong>
    <%= chatgpt.max_tokens %>
  </p>

  <p>
    <strong>Reason for termination:</strong>
    <%= chatgpt.reason_for_termination %>
  </p>

  <p>
    <strong>Usage:</strong>
    <%= chatgpt.usage %>
  </p>
</div>
