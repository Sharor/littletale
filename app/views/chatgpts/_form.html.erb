<%= form_with(model: chatgpt) do |form| %>
  <% if chatgpt.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(chatgpt.errors.count, "error") %> prohibited this chatgpt from being saved:</h2>

      <ul>
        <% chatgpt.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :prompt, style: "display: block" %>
    <%= form.text_area :prompt %>
  </div>

  <div>
    <%= form.label :answer, style: "display: block" %>
    <%= form.text_area :answer %>
  </div>

  <div>
    <%= form.label :max_tokens, style: "display: block" %>
    <%= form.number_field :max_tokens %>
  </div>

  <div>
    <%= form.label :reason_for_termination, style: "display: block" %>
    <%= form.text_area :reason_for_termination %>
  </div>

  <div>
    <%= form.label :usage, style: "display: block" %>
    <%= form.text_area :usage %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
