<%# Renders one character card %>
<div id="<%= dom_id(character) %>">
  Breaks here
  <% if illustration&.original_image&.url&.blank? %>
    <%= render "characters/processing_preview", character: character %>
    U
  <% else %>
    <%# Wrapper div is important to ensure relationship for tailwind peer toggling the hidden checkbox. %>
    <div id="<%= dom_id(character) %>"> 
      <%# 1. Hidden Checkbox (The Peer) %>
      <%= form.check_box :character_ids, { multiple: true, class: "peer hidden", id: "character_checkbox_#{character.id}" }, character.id, nil %>

      <%# 2. Visual Card (The Adjacent Sibling) - Holds all styling and the manual click handler %>
      <div class="cursor-pointer group block rounded-xl border p-4 text-center transition-all duration-200 h-full relative
                peer-checked:bg-blue-100 peer-checked:ring-2 peer-checked:ring-blue-500"
        onclick="document.getElementById('character_checkbox_<%= character.id %>').click();">

        <div class="relative w-full px-1 mb-2">
          <%# ---------------------- EDIT ICON ---------------------- %>
          <%= link_to edit_character_path(character),
              class: "absolute left-0 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition duration-150 text-gray-400 hover:text-cyan-400 z-30" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-9-4l9-9m-7 7l-2 2m0 0l-5 5"/>
            </svg>
          <% end %>

          <h2 class="text-sm md:text-base font-semibold truncate">
            <%= character.name %>
          </h2>

          <%# ---------------------- DELETE ICON (MODAL TRIGGER) ---------------------- %>
          <%= link_to confirm_delete_character_path(character),
              class: "absolute right-0 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition duration-150 text-gray-400 hover:text-red-500 z-30",
              data: { turbo_frame: "modal" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          <% end %>

        </div>

        <%# CHARACTER IMAGE %>
        <div class="rounded-lg overflow-hidden w-full h-40 aspect-[3/3] mt-4 mb-3">
          <% if character.illustration.present? %>
            <%= render partial: "illustrations/illustration", locals: { illustration: character.illustration } %>
          <% else %>
            <div class="w-full h-full bg-gray-700 flex items-center justify-center">
              <p class="text-gray-400 text-xs"><%= t("characters.show.no_image") %></p>
            </div>
          <% end %>
        </div>

      </div>
    </div>
  <% end %>
</div>
