<div class="fable-layout">
  <%= render "layouts/sidebar" %>
  <main class="fable-main fable-ui fable-character-detail">
<%= turbo_stream_from current_user, :characters %>
<%= render "illustrations/illustration", character: @character %>
<p style="color: green"><%= notice %></p>


<div>
  <%= link_to t("characters.show.edit"), edit_character_path(@character) %> |
  <%= link_to t("characters.show.back"), characters_path %>

  <%= button_to t("characters.show.destroy"), @character, method: :delete %>
</div>

  </main>
</div>
