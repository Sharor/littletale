<%= turbo_stream_from current_user, :characters %>


<div class="app-wrapper flex flex-col lg:flex-row text-white">
  <%= render "layouts/sidebar" %> 


  <main class="flex-grow p-6 lg:p-10">
    <div class="flex justify-between items-center mb-8 pb-2 border-b border-white/20">
      <h2 class="text-4xl font-extrabold">Characters</h2>
    </div>

    <%# START FORM: Collects character IDs via GET request (URL parameters) %>
    <%= form_with url: new_book_path, method: :get, local: true do |form| %>

      <div class="justify-center items-center grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6 p-8">
        <%# =============== NEW CHARACTER TILE =============== %>
        <%= link_to new_character_path, class: "block" do %>
          <div class="rounded-xl p-4 frosted-glass flex flex-col items-center text-center border-2 border-dashed border-white/30 hover:border-cyan-400 transition hover:shadow-lg hover:shadow-cyan-500/30 cursor-pointer my-auto">
            <div class="flex flex-col items-center justify-center flex-grow w-full">
              <h2 class="text-sm md:text-base font-semibold truncate w-full px-1 invisible h-0 overflow-hidden">Placeholder</h2>
              <div class="rounded-lg w-full aspect-[3/3] mt-4 mb-3 flex flex-col items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-cyan-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                <span class="text-sm font-medium text-cyan-400">New Character</span>
              </div>
            </div>
          </div>
        <% end %>
        <%# ================================================== %>


        <% @characters.each do |character| %>
          <%# Wrapper div is important to ensure relationship for tailwind peer toggling the hidden checkbox. %>
          <div id="<%= dom_id(character) %>"> 
            <%# 1. Hidden Checkbox (The Peer) %>
            <%= form.check_box :character_ids, { multiple: true, class: "peer hidden", id: "character_checkbox_#{character.id}" }, character.id, nil %>

            <%# 2. Visual Card (The Adjacent Sibling) - Holds all styling and the manual click handler %>
            <div class="cursor-pointer group block rounded-xl border p-4 text-center transition-all duration-200 relative
                    peer-checked:bg-blue-100 peer-checked:ring-2 peer-checked:ring-blue-500"
              onclick="document.getElementById('character_checkbox_<%= character.id %>').click();"
            >

            <div class="relative w-full">
              <div class="px-6"> 
                <h2 class="text-sm md:text-base font-semibold truncate">
                  <%= character.name %>
                </h2>
              </div>

              <%# EDIT ICON - Left side %>
              <%= link_to edit_character_path(character),
                  class: "absolute left-0 top-1/2 -translate-y-1/2 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition duration-150 text-gray-400 hover:text-cyan-400 z-30 p-1",
                  onclick: "event.stopPropagation();" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-9-4l9-9m-7 7l-2 2m0 0l-5 5"/>
                </svg>
              <% end %>

              <%# DELETE ICON - Right side %>
              <%= link_to confirm_delete_character_path(character),
                  class: "absolute right-0 top-1/2 -translate-y-1/2 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition duration-150 text-gray-400 hover:text-red-500 z-30 p-1",
                  data: { turbo_frame: "modal" },
                  onclick: "event.stopPropagation();" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>

            <%# CHARACTER IMAGE %>
            <div class="rounded-lg overflow-hidden  mt-4 ">
              <div id="illustration_character_<%= character.id %>">
                <%= render partial: "illustrations/illustration", locals: { character: character } %>
              </div>
            </div>

            </div>
          </div>
        <% end %>
      </div>

      <%# Submit Button (Guaranteed to work by using simple HTML button) %>
      <div class="mt-8 text-center mb-8">
        <button type="submit" class="px-6 py-3 bg-cyan-600 text-white font-semibold rounded-lg hover:bg-cyan-500 transition duration-200 cursor-pointer">
          <%= t("helpers.submit.character.add", default: "Create Book with Selected Characters") %>
        </button>
      </div>
    <% end %>
  </main> 
</div>
