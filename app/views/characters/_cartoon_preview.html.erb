<div id="character-<%= char_id %>" class="space-y-4" data-mode-content="photo">
    
    <h3 class="text-xl font-bold text-white text-center"><%= character.name %></h3>
    
    <div class="relative w-full min-h-48 max-h-[30rem] bg-gray-700 rounded-lg flex items-center justify-center overflow-hidden">
        
        <% if character.illustration.present? %>
            <%= image_tag character.illustration.original_image.url, 
                          id: "char-#{char_id}-photo-preview", 
                          class: "w-full object-contain block" %>
        <% else %>
            <span class="text-red-400"><%= t("characters.form.image_failed") %></span>
        <% end %>
    </div>

    <p class="text-green-400 text-sm font-semibold text-center pt-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        Character Preview Generated!
    </p>

    <div class="pt-4 flex justify-center">
        <button type="button" 
                class="px-4 py-2 bg-gray-700 rounded-lg text-white font-semibold hover:bg-gray-600 transition"
                onclick="window.bookWizard.toggleMode(<%= char_id %>)">
            Re-Upload or Describe Manually
        </button>
    </div>
</div>
