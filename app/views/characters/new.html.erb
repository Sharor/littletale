<div class="app-wrapper flex flex-col lg:flex-row text-white">
  <%= render "layouts/sidebar" %>

  <div class="flex-grow flex items-start lg:items-center justify-center min-h-[80vh] w-full">
    <div id="character-creation-container" class="w-full max-w-4xl frosted-glass rounded-2xl shadow-2xl p-6 md:p-10 my-8">

      <h1 class="text-4xl font-extrabold text-white mb-6 border-b border-white/20 pb-3">
        <%= @character.persisted? ? "Edit Character" : "New Character Creation" %>
      </h1>

      <%= form_with(model: @character, local: true, html: { class: 'space-y-6', multipart: true }) do |form| %>
        <% character_creation_mode = @character.creation_mode || (@character.persisted? && !@character.photo.attached? ? "form" : "photo") %>
        <%= form.hidden_field :creation_mode, id: "character_creation_mode", value: character_creation_mode %>

        <%# 1. Name Input %>
        <div class="space-y-2">
          <label class="block text-sm font-medium <%= @character.errors[:name].any? ? 'text-red-400' : 'text-gray-300' %>" for="character_name">
            Character Name (Required)
          </label>
          <%= form.text_field :name,
              placeholder: "Name (e.g., Elara)",
              class: "w-full p-2 rounded-md bg-white/10 border #{ @character.errors[:name].any? ? 'border-red-500' : 'border-white/10' } text-white placeholder-gray-400 focus:ring-cyan-500 focus:border-cyan-500" %>
          <% if @character.errors[:name].any? %>
            <p class="text-xs text-red-400 mt-1"><%= @character.errors[:name].first %></p>
          <% end %>
        </div>

        <%# 2. Roles Selection %>
        <div class="space-y-4 border-t border-white/10 pt-4">
          <h3 class="text-lg font-medium text-gray-300">Character Role(s) (Optional)</h3>
          <div class="grid grid-cols-2 gap-4">
            <% character_options[:roles].each do |role| %>
              <% role_id = "character_roles_#{role.to_s.gsub(/[^a-z0-9_]+/i, '_')}" %>
              <div class="relative">
                <label for="<%= role_id %>" class="cursor-pointer">
                  <%= form.check_box :roles, { include_hidden: false, id: role_id, class: "hidden peer role-checkbox-form" }, role, nil %>
                  <div class="rounded-xl border border-white/20 p-4 text-center transition-all duration-200 text-sm font-semibold hover:bg-white/5 peer-checked:bg-cyan-900 peer-checked:ring-2 peer-checked:ring-cyan-500 peer-checked:border-cyan-500">
                    <%= format_option_for_display(role) %>
                  </div>
                </label>
              </div>
            <% end %>
          </div>
        </div>

        <%# 3. Mode TABS %>
        <div class="border-b border-white/20 mb-6">
          <nav class="flex space-x-2" aria-label="Tabs">
            <button type="button" id="tab-photo" onclick="toggleMode('photo')"
                    class="mode-tab px-4 py-2 text-sm font-medium rounded-t-lg transition-colors duration-150 <%= character_creation_mode == 'photo' ? 'bg-cyan-700 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-700' %>">
              Photo Upload
            </button>
            <button type="button" id="tab-form" onclick="toggleMode('form')"
                    class="mode-tab px-4 py-2 text-sm font-medium rounded-t-lg transition-colors duration-150 <%= character_creation_mode == 'form' ? 'bg-cyan-700 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-700' %>">
              Descriptive Form
            </button>
          </nav>
        </div>

        <%# 4. Mode CONTENT CONTAINERS %>

        <%# Photo Mode %>
        <div id="content-photo" class="mode-content space-y-4 <%= 'hidden' if character_creation_mode == 'form' %>">
          <h2 class="text-xl font-semibold text-white">Upload Character Photo</h2>

          <div class="flex items-center space-x-4">
            <label class="block cursor-pointer px-4 py-2 bg-gray-700 text-white font-semibold rounded-lg hover:bg-gray-600 transition duration-200 border <%= @character.errors[:photo].any? ? 'border-red-500' : 'border-transparent' %>">
              Choose Photo
              <%= form.file_field :photo_upload, accept: "image/*", class: "hidden", id: "character_photo_upload", onchange: "handlePhotoPreview(this.files[0])" %>
            </label>
            <span id="file-name-display" class="text-sm text-gray-400">No file chosen.</span>
          </div>
          <% if @character.errors[:photo].any? %>
            <p class="text-xs text-red-400 mt-1">Photo upload <%= @character.errors[:photo].first %></p>
          <% end %>

          <div id="photo-preview-container" class="mt-6">
            <div id="character-photo-preview-image" class="w-full h-64 border border-white/20 rounded-xl overflow-hidden shadow-lg bg-gray-900/50 flex items-center justify-center">
              <p class="text-gray-500">Your photo preview will appear here.</p>
            </div>
          </div>
        </div>

        <%# Descriptive Form Mode %>
        <div id="content-form" class="mode-content space-y-6 <%= 'hidden' unless character_creation_mode == 'form' %>">
          <h2 class="text-xl font-semibold text-white">Character Appearance</h2>
          <div class="md:col-span-1 space-y-2">
            <label class="block text-sm font-medium <%= @character.errors[:age].any? ? 'text-red-400' : 'text-gray-300' %>" for="character_age">
                Age
            </label>
            <%= form.number_field :age,
                placeholder: "25",
                class: "w-full p-2 rounded-md bg-white/10 border #{ @character.errors[:age].any? ? 'border-red-500' : 'border-white/10' } text-white placeholder-gray-400 focus:ring-cyan-500 focus:border-cyan-500" %>
            <% if @character.errors[:age].any? %>
                <p class="text-xs text-red-400 mt-1"><%= @character.errors[:age].first %></p>
            <% end %>
        </div>
          <div class="grid grid-cols-2 gap-4">
            <% { gender: 'Gender', ethnicity: 'Ethnicity / Appearance', hair_style: 'Hair Style', hair_color: 'Hair Color', eye_color: 'Eye Color' }.each do |field, label| %>
              <div class="space-y-1">
                <label class="block text-sm font-medium <%= @character.errors[field].any? ? 'text-red-400' : 'text-gray-300' %>"><%= label %></label>
                <%= form.select field,
                    options_for_select([['-- Select --', '']] + character_options[field].map { |opt| [format_option_for_display(opt), opt] }, @character.send(field)),
                    {},
                    class: "w-full p-2 rounded-md bg-white text-gray-800 border #{ @character.errors[field].any? ? 'border-red-500' : 'border-white/10' } focus:ring-cyan-500 focus:border-cyan-500" %>
                <% if @character.errors[field].any? %>
                  <p class="text-[10px] text-red-400 mt-1"><%= @character.errors[field].first %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%# 5. Buttons %>
        <div class="flex justify-between mt-10 pt-6 border-t border-white/10">
          <%= link_to 'Back', characters_path, class: "px-6 py-3 bg-gray-700 text-white font-semibold rounded-lg hover:bg-gray-600 transition duration-200" %>
          <%= form.submit "Save", class: "px-6 py-3 bg-cyan-600 text-white font-semibold rounded-lg hover:bg-cyan-500 transition duration-200 cursor-pointer" %>
        </div>
      <% end %>

      <script type="text/javascript">
        function toggleMode(mode) {
            document.getElementById('character_creation_mode').value = mode;
            const allContent = document.querySelectorAll('.mode-content');
            const allTabs = document.querySelectorAll('.mode-tab');

            allContent.forEach(content => content.classList.add('hidden'));
            allTabs.forEach(tab => {
                tab.classList.remove('bg-cyan-700', 'text-white');
                tab.classList.add('text-gray-400', 'hover:text-white', 'hover:bg-gray-700');
            });

            document.getElementById(`content-${mode}`).classList.remove('hidden');
            const selectedTab = document.getElementById(`tab-${mode}`);
            selectedTab.classList.remove('text-gray-400', 'hover:text-white', 'hover:bg-gray-700');
            selectedTab.classList.add('bg-cyan-700', 'text-white');
        }

        function handlePhotoPreview(file) {
            const fileNameDisplay = document.getElementById('file-name-display');
            const previewContainer = document.getElementById('photo-preview-container');

            if (!file) {
                fileNameDisplay.textContent = 'No file chosen.';
                previewContainer.innerHTML = `<div id="character-photo-preview-image" class="w-full h-64 border border-white/20 rounded-xl overflow-hidden shadow-lg bg-gray-900/50 flex items-center justify-center"><p class="text-gray-500">Your photo preview will appear here.</p></div>`;
                return;
            }

            fileNameDisplay.textContent = file.name;
            const formData = new FormData();
            formData.append('photo', file);

            previewContainer.innerHTML = `<div class="w-full h-64 border border-white/20 rounded-xl overflow-hidden shadow-lg bg-gray-900/50 flex items-center justify-center"><svg class="animate-spin h-8 w-8 text-cyan-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><p class="ml-3 text-cyan-400">Generating preview...</p></div>`;

            fetch('/characters/photo_preview', {
                method: 'POST',
                body: formData,
                headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
            })
            .then(response => response.text())
            .then(html => { previewContainer.innerHTML = html; })
            .catch(error => {
                previewContainer.innerHTML = `<div class="w-full h-64 border border-white/20 rounded-xl overflow-hidden shadow-lg bg-red-900/50 flex items-center justify-center"><p class="text-red-400">Failed to load preview.</p></div>`;
            });
        }
      </script>
    </div>
  </div>
</div>
