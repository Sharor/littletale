<%
  # Helper function to generate <option> tags dynamically (mimicking the JS helper)
  def select_options(options_array, default_text)
    options_array.map do |option|
      value = option.downcase.gsub(/\s+/, '_')
      "<option value=\"#{value}\">#{option}</option>"
    end.unshift("<option value=\"\" disabled selected>#{default_text}</option>").join.html_safe
  end
%>

<%# Character Content Body: This block renders the Detailed Form by default %>
<div id="char-<%= char_id %>-body">
    <div class="space-y-4" data-mode-content="form">
        <label class="block text-sm font-medium"><%= t("characters.form.name") %></label>
        <input type="text" 
                name="character[<%= char_id %>][name]" 
                id="char-<%= char_id %>-name" 
                placeholder="<%= t("characters.form.name_placeholder") %>"
                class="w-full p-2 rounded-md bg-white/10 border border-white/10 text-white placeholder-gray-400 focus:ring-cyan-500 focus:border-cyan-500 character-name-input">
        <p id="char-<%= char_id %>-error-name" class="text-red-400 text-xs mt-1 hidden"></p>

        <%# GENDER FIELD %>
        <div class="text-center pt-2">
            <label class="block text-sm font-medium"><%= t("characters.form.gender") %></label>
            <select name="character[<%= char_id %>][gender]"
                    class="w-full p-2 rounded-md bg-white/10 border border-white/10 text-white focus:ring-cyan-500 focus:border-cyan-500">
                <%= select_options(Character::GENDERS, t("characters.form.select")) %>
            </select>
        </div>
        
        <%# ETHNICITY & HAIR COLOR GRID %>
        <div class="grid grid-cols-2 gap-4 pt-2">
            <div class="text-center">
                <label class="block text-sm font-medium"><%= t("characters.form.ethnicity") %></label>
                <select name="character[<%= char_id %>][ethnicity]"
                        class="w-full p-2 rounded-md bg-white/10 border border-white/10 text-white focus:ring-cyan-500 focus:border-cyan-500">
                    <%= select_options(Character::ETHNICITIES, t("characters.form.select")) %>
                </select>
            </div>
            <div class="text-center">
                <label class="block text-sm font-medium"><%= t("characters.form.hair_color") %></label>
                <select name="character[<%= char_id %>][hair_color]"
                        class="w-full p-2 rounded-md bg-white/10 border border-white/10 text-white focus:ring-cyan-500 focus:border-cyan-500">
                    <%= select_options(Character::HAIRCOLORS, t("characters.form.select")) %>
                </select>
            </div>
        </div>

        <%# HAIR STYLE & EYE COLOR GRID %>
        <div class="grid grid-cols-2 gap-4 pt-2">
            <div class="text-center"> 
                <label class="block text-sm font-medium"><%= t("characters.form.hair_style") %></label>
                <select name="character[<%= char_id %>][hair_style]"
                        class="w-full p-2 rounded-md bg-white/10 border border-white/10 text-white focus:ring-cyan-500 focus:border-cyan-500">
                    <%= select_options(Character::HAIRSTYLES, t("characters.form.select")) %>
                </select>
            </div>
            <div class="text-center">
                <label class="block text-sm font-medium"><%= t("characters.form.eye_color") %></label>
                <select name="character[<%= char_id %>][eye_color]"
                        class="w-full p-2 rounded-md bg-white/10 border border-white/10 text-white focus:ring-cyan-500 focus:border-cyan-500">
                    <%= select_options(Character::EYECOLORS, t("characters.form.select")) %>
                </select>
            </div>
        </div>
        
        <%# APPEARANCE / TRAITS TEXTAREA %>
        <label class="block text-sm font-medium pt-2"><%= t("characters.form.detailed_description") %></label>
        <textarea name="character[<%= char_id %>][description]" 
                    placeholder="<%= t("characters.form.description_placeholder") %>"
                    rows="3" 
                    class="w-full p-2 rounded-md bg-white/10 border border-white/10 text-white placeholder-gray-400 focus:ring-cyan-500 focus:border-cyan-500"></textarea>

        <%# ROLES CHECKBOX GRID %>
        <label class="block text-sm font-medium pt-2"><%= t("characters.form.roles_all") %></label>
        <div class="character_attributes p-1 -m-1">
            <div class="grid grid-cols-2 gap-4">
                <% Character::ROLES.each do |role| %>
                    <% sanitized_role = role.downcase.gsub(/[^a-z0-9]+/i, '_') %>
                    <label for="char-<%= char_id %>-role-<%= sanitized_role %>" class="cursor-pointer">
                        <input type="checkbox" 
                                name="character[<%= char_id %>][roles][]" 
                                value="<%= role %>" 
                                id="char-<%= char_id %>-role-<%= sanitized_role %>" 
                                class="peer hidden">
                        <div class="rounded-xl border border-white/20 p-4 text-center transition-all duration-200 hover:bg-white/5 
                                    peer-checked:bg-cyan-900 peer-checked:ring-2 peer-checked:ring-cyan-500 peer-checked:border-cyan-500">
                            <%= format_option_for_display(role) %>
                        </div>
                    </label>
                <% end %>
            </div>
        </div>
    </div>
</div>
