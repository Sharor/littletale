<div class="fable-public fable-landing">
  <nav class="fable-public-nav" aria-label="Main navigation">
    <div class="fable-public-brand">
      <%= image_tag "logo_small.png", alt: "LittleStories Logo" %>
      <span>LittleStories</span>
    </div>
    <div class="fable-public-nav-links">
      <a href="#how-it-works">Process</a>
      <a href="#about">Our Story</a>
    </div>
    <%= link_to "Get Started", new_user_session_path, class: "fable-public-button fable-public-button-outline" %>
  </nav>

  <main aria-labelledby="landing-title">
    <header class="fable-public-hero">
      <div class="fable-public-hero-copy">
        <h1 id="landing-title">Turn your child into a <span>Storybook Hero.</span></h1>
        <p class="fable-public-intro">Upload a photo, choose an adventure, and watch your child become the star of their very own cartoon-illustrated book.</p>
        <div class="fable-public-hero-actions">
          <%= link_to "Create Your Story", new_user_session_path, class: "fable-public-button" %>
          <span class="fable-public-parent-note">Join 2,000+ happy parents</span>
        </div>
      </div>

      <div class="fable-public-story-cover">
        <span class="fable-public-cover-ribbon" aria-hidden="true"></span>
        <div class="fable-public-transformation">
          <%= image_tag "landing-page-kid.png", alt: "Photo of a small boy" %>
          <%= image_tag "landing-boy-cartoonified.png", alt: "Photo of the small boy as a cartoon" %>
        </div>
        <span class="fable-public-flourish" aria-hidden="true">❧</span>
      </div>
    </header>

    <section id="how-it-works" class="fable-public-process">
      <div>
        <h2>How the magic happens</h2>
        <div class="fable-public-steps">
          <div class="reveal-on-scroll fable-public-step">
            <span class="fable-public-step-number">1</span>
            <div>
              <h3>Upload &amp; Plot</h3>
              <p>Add photos and describe your dream adventure.</p>
            </div>
          </div>
          <div class="reveal-on-scroll fable-public-step" style="transition-delay: 100ms;">
            <span class="fable-public-step-number">2</span>
            <div>
              <h3>AI Illustration</h3>
              <p>Our engine transforms faces into consistent cartoon characters.</p>
            </div>
          </div>
          <div class="reveal-on-scroll fable-public-step" style="transition-delay: 200ms;">
            <span class="fable-public-step-number">3</span>
            <div>
              <h3>Instant Storybook</h3>
              <p>A full-color, high-res PDF or physical book delivered to you.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="fable-public-film">
        <span class="fable-public-play" aria-hidden="true">▷</span>
        <p>Watch the transformation</p>
      </div>
    </section>

    <section class="fable-public-testimonial">
      <p class="fable-public-eyebrow">As seen on / Trusted by</p>
      <div class="fable-public-publications">
        <span>ParentingHub</span>
        <span>TechKids</span>
        <span>StoryDaily</span>
        <span>MiniMinds</span>
      </div>
      <blockquote>
        <p>"My daughter didn't believe it was her until she saw her favorite teddy bear in the cartoon. She's read it every night for a month!"</p>
        <cite>— Sarah J., Proud Mom</cite>
      </blockquote>
    </section>

    <section id="about" class="fable-public-about">
      <div class="fable-public-founder"><span>Founder Photo</span></div>
      <div>
        <h2>Why we built LittleStories</h2>
        <div class="fable-public-prose">
          <p>It started when I tried to find a book for my son where the hero looked like him. Not "kind of" like him, but <em>really</em> him.</p>
          <p>We realized that AI could be used for more than just data—it could be used for wonder. Our mission at LittleStories is to bridge the gap between a child's imagination and the physical world, making every bedtime a personal adventure.</p>
        </div>
        <p class="fable-public-signature">Personalized with love.</p>
      </div>
    </section>
  </main>
</div>
