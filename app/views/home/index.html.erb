<div class="text-white font-sans selection:bg-indigo-500/30">

  <nav class="flex justify-between items-center px-8 py-6 max-w-7xl mx-auto">
    <div class="flex items-center gap-2">
      <div class="w-15 h-15 bg-gradient-to-tr from-indigo-500 to-cyan-400 rounded-xl shadow-lg flex items-center justify-center">
        <%= image_tag "logo_small.png", class: "h-13 w-13 object-contain", alt: "LittleStories Logo" %>
      </div>
      <span class="text-2xl font-black tracking-tighter">LittleStories</span>
    </div>
    <div class="hidden md:flex gap-8 text-sm font-medium text-gray-300">
      <a href="#how-it-works" class="hover:text-white transition">Process</a>
      <a href="#about" class="hover:text-white transition">Our Story</a>
    </div>
    <%= link_to "Get Started", new_user_session_path, class: "px-6 py-2 bg-white text-gray-900 rounded-full font-bold text-sm hover:bg-indigo-50 transition transform hover:scale-105" %>
  </nav>

  <header class="max-w-7xl mx-auto px-8 pt-20 pb-32 text-center md:text-left flex flex-col md:flex-row items-center gap-12">
    <div class="md:w-1/2">
      <h1 class="text-5xl md:text-7xl font-black leading-[1.1] mb-6">
        Turn your child into a <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Storybook Hero.</span>
      </h1>
      <p class="text-xl text-gray-300 mb-10 max-w-lg leading-relaxed">
        Upload a photo, choose an adventure, and watch your child become the star of their very own cartoon-illustrated book.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <%= link_to "Create Your Story", new_user_session_path, class: "px-8 py-4 bg-indigo-600 hover:bg-indigo-500 rounded-2xl font-extrabold text-lg shadow-xl shadow-indigo-500/20 text-center transition-all transform hover:-translate-y-1" %>
        <div class="flex items-center gap-3 px-6 text-gray-400">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 rounded-full bg-gray-600 border-2 border-slate-800"></div>
            <div class="w-8 h-8 rounded-full bg-gray-500 border-2 border-slate-800"></div>
          </div>
          <span class="text-sm">Join 2,000+ happy parents</span>
        </div>
      </div>
    </div>

    <div class="md:w-1/2 relative">
      <div class="relative z-10 bg-white/10 backdrop-blur-2xl border border-white/20 p-4 rounded-[2.5rem] shadow-3xl transform rotate-3">
        <div class="aspect-[4/3] rounded-3xl overflow-hidden bg-gray-800 flex items-center justify-center">
           <div class="grid grid-cols-2 h-full w-full">
             <div class="bg-gray-700 flex items-center justify-center border-r border-white/10 italic text-gray-400"> <%= image_tag "landing-page-kid.png", class: "w-full h-full object-cover", alt: "Photo of a small boy" %></div>
             <div class="bg-indigo-900/50 flex items-center justify-center font-bold text-indigo-200"> <%= image_tag "landing-boy-cartoonified.png", class: "w-full h-full object-cover", alt: "Photo of the small boy as a cartoon" %></div>
           </div>
        </div>
      </div>
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-purple-500/30 blur-3xl rounded-full animate-pulse"></div>
      <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-cyan-500/20 blur-3xl rounded-full"></div>
    </div>
  </header>

  <section id="how-it-works" class="max-w-7xl mx-auto px-8 py-24 border-t border-white/10">
    <div class="flex flex-col lg:flex-row gap-16 items-center">
      <div class="lg:w-1/2 space-y-8">
        <h2 class="text-4xl font-black mb-8">How the magic happens</h2>
        <div class="space-y-6">
          <div class="reveal-on-scroll flex gap-6 p-6 bg-white/5 border border-white/10 rounded-2xl">
            <div class="w-10 h-10 shrink-0 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">1</div>
            <div>
              <h3 class="font-bold text-lg text-white">Upload & Plot</h3>
              <p class="text-gray-400">Add photos and describe your dream adventure.</p>
            </div>
          </div>
          <div class="reveal-on-scroll flex gap-6 p-6 bg-white/5 border border-white/10 rounded-2xl" style="transition-delay: 100ms;">
            <div class="w-10 h-10 shrink-0 bg-purple-500 rounded-lg flex items-center justify-center font-bold">2</div>
            <div>
              <h3 class="font-bold text-lg text-white">AI Illustration</h3>
              <p class="text-gray-400">Our engine transforms faces into consistent cartoon characters.</p>
            </div>
          </div>
          <div class="reveal-on-scroll flex gap-6 p-6 bg-white/5 border border-white/10 rounded-2xl" style="transition-delay: 200ms;">
            <div class="w-10 h-10 shrink-0 bg-cyan-500 rounded-lg flex items-center justify-center font-bold">3</div>
            <div>
              <h3 class="font-bold text-lg text-white">Instant Storybook</h3>
              <p class="text-gray-400">A full-color, high-res PDF or physical book delivered to you.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:w-1/2 w-full">
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-cyan-500 rounded-[2rem] blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
          <div class="relative bg-black rounded-[2rem] overflow-hidden aspect-video border border-white/20 shadow-2xl flex items-center justify-center">
            <div class="text-center">
              <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4 backdrop-blur-md">
                <div class="w-0 h-0 border-t-[10px] border-t-transparent border-l-[18px] border-l-white border-b-[10px] border-b-transparent ml-1"></div>
              </div>
              <p class="text-sm font-medium text-gray-400 uppercase tracking-widest">Watch the transformation</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white/5 backdrop-blur-sm border-y border-white/10">
    <div class="max-w-7xl mx-auto px-8">
      <p class="text-center text-gray-400 text-sm font-bold uppercase tracking-widest mb-10">As seen on / Trusted by</p>
      <div class="flex flex-wrap justify-center items-center gap-12 opacity-50 grayscale">
        <span class="text-2xl font-bold">ParentingHub</span>
        <span class="text-2xl font-bold">TechKids</span>
        <span class="text-2xl font-bold">StoryDaily</span>
        <span class="text-2xl font-bold">MiniMinds</span>
      </div>
      
      <div class="mt-20 max-w-3xl mx-auto text-center">
        <p class="text-2xl italic text-gray-200">"My daughter didn't believe it was her until she saw her favorite teddy bear in the cartoon. She's read it every night for a month!"</p>
        <div class="mt-6 font-bold text-indigo-400">— Sarah J., Proud Mom</div>
      </div>
    </div>
  </section>

  <section id="about" class="max-w-5xl mx-auto px-8 py-32">
    <div class="flex flex-col md:flex-row gap-16 items-center">
      <div class="w-48 h-48 shrink-0 rounded-full bg-gradient-to-tr from-gray-700 to-gray-500 border-4 border-white/10 shadow-2xl flex items-center justify-center overflow-hidden">
        <span class="text-xs text-gray-400 italic">Founder Photo</span>
      </div>
      <div>
        <h2 class="text-3xl font-black mb-6">Why we built LittleStories</h2>
        <div class="prose prose-invert text-gray-300 space-y-4">
          <p>It started when I tried to find a book for my son where the hero looked like him. Not "kind of" like him, but <em>really</em> him.</p>
          <p>We realized that AI could be used for more than just data—it could be used for wonder. Our mission at LittleStories is to bridge the gap between a child's imagination and the physical world, making every bedtime a personal adventure.</p>
        </div>
        <div class="mt-8 flex items-center gap-4">
          <div class="h-px w-12 bg-indigo-500"></div>
          <span class="text-sm font-bold uppercase tracking-tighter italic">Personalized with love.</span>
        </div>
      </div>
    </div>
  </section>

</div>