<div class="fable-public fable-landing">
  <nav class="fable-public-nav" aria-label="<%= t("landing.navigation") %>">
    <div class="fable-public-brand">
      <%= image_tag "logo_small.png", alt: "LittleStories Logo" %>
      <span>LittleStories</span>
    </div>
    <div class="fable-public-nav-links">
      <a href="#how-it-works"><%= t("landing.process") %></a>
      <a href="#about"><%= t("landing.our_story") %></a>
    </div>
    <%= link_to t("landing.get_started"), new_user_session_path, class: "fable-public-button fable-public-button-outline" %>
  </nav>

  <main aria-labelledby="landing-title">
    <header class="fable-public-hero">
      <div class="fable-public-hero-copy">
        <h1 id="landing-title"><%= t("landing.title_html") %></h1>
        <p class="fable-public-intro"><%= t("landing.introduction") %></p>
        <div class="fable-public-hero-actions">
          <%= link_to t("landing.create"), new_user_session_path, class: "fable-public-button" %>
          <span class="fable-public-parent-note"><%= t("landing.parents") %></span>
        </div>
      </div>

      <div class="fable-public-story-cover">
        <span class="fable-public-cover-ribbon" aria-hidden="true"></span>
        <div class="fable-public-transformation">
          <%= image_tag "landing-page-kid.png", alt: t("landing.photo_alt") %>
          <%= image_tag "landing-boy-cartoonified.png", alt: t("landing.cartoon_alt") %>
        </div>
        <span class="fable-public-flourish" aria-hidden="true">❧</span>
      </div>
    </header>

    <section id="how-it-works" class="fable-public-process">
      <div>
        <h2><%= t("landing.magic_title") %></h2>
        <div class="fable-public-steps">
          <div class="reveal-on-scroll fable-public-step">
            <span class="fable-public-step-number">1</span>
            <div>
              <h3><%= t("landing.steps.upload.title") %></h3>
              <p><%= t("landing.steps.upload.description") %></p>
            </div>
          </div>
          <div class="reveal-on-scroll fable-public-step" style="transition-delay: 100ms;">
            <span class="fable-public-step-number">2</span>
            <div>
              <h3><%= t("landing.steps.illustration.title") %></h3>
              <p><%= t("landing.steps.illustration.description") %></p>
            </div>
          </div>
          <div class="reveal-on-scroll fable-public-step" style="transition-delay: 200ms;">
            <span class="fable-public-step-number">3</span>
            <div>
              <h3><%= t("landing.steps.storybook.title") %></h3>
              <p><%= t("landing.steps.storybook.description") %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="fable-public-film">
        <span class="fable-public-play" aria-hidden="true">▷</span>
        <p><%= t("landing.watch") %></p>
      </div>
    </section>

    <section class="fable-public-testimonial">
      <p class="fable-public-eyebrow"><%= t("landing.trusted") %></p>
      <div class="fable-public-publications">
        <span>ParentingHub</span>
        <span>TechKids</span>
        <span>StoryDaily</span>
        <span>MiniMinds</span>
      </div>
      <blockquote>
        <p><%= t("landing.testimonial.quote") %></p>
        <cite><%= t("landing.testimonial.author") %></cite>
      </blockquote>
    </section>

    <section id="about" class="fable-public-about">
      <div class="fable-public-founder"><span><%= t("landing.founder_photo") %></span></div>
      <div>
        <h2><%= t("landing.about.title") %></h2>
        <div class="fable-public-prose">
          <p><%= t("landing.about.origin_html") %></p>
          <p><%= t("landing.about.mission") %></p>
        </div>
        <p class="fable-public-signature"><%= t("landing.about.signature") %></p>
      </div>
    </section>
  </main>
</div>
