<main class="fable-public fable-public-login" aria-labelledby="login-title">
  <% if notice %>
    <p class="fable-public-notice" role="status"><%= notice %></p>
  <% end %>

  <div class="fable-public-welcome-book">
    <div class="fable-public-welcome-cover">
      <%= image_tag "frontpage.png", alt: "Little Stories fairytale book cover" %>
    </div>
    <div class="fable-public-welcome-copy">
      <header>
        <h1 id="login-title"><%= t("authentication.fantasy") %></h1>
        <p class="fable-public-subtitle"><%= t("authentication.limits") %></p>
      </header>
      <div class="fable-public-prose">
        <p><%= t("authentication.welcome") %></p>
        <p><%= t("authentication.process") %></p>
        <p><%= t("authentication.how") %></p>
        <p><%= t("authentication.magic") %></p>
        <p><%= t("authentication.get_started") %></p>
      </div>
      <div class="fable-public-social-options">
        <%= button_to user_google_oauth2_omniauth_authorize_path, class: "fable-public-button fable-public-google", method: :post, data: { turbo: "false", turbolinks: false } do %>
          <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 488 512"><path fill="currentColor" d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z"></path></svg>
          <%= t("authentication.login_google") %>
        <% end %>
        <% if omniauth_provider_configured?(:microsoft_v2_auth) %>
          <%= button_to user_microsoft_v2_auth_omniauth_authorize_path, class: "fable-public-button fable-public-microsoft", method: :post, data: { turbo: "false", turbolinks: false } do %>
            <svg aria-hidden="true" focusable="false" viewBox="0 0 23 23"><path fill="#f35325" d="M1 1h10v10H1z"/><path fill="#81bc06" d="M12 1h10v10H12z"/><path fill="#05a6f0" d="M1 12h10v10H1z"/><path fill="#ffba08" d="M12 12h10v10H12z"/></svg>
            <%= t("authentication.login_microsoft") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</main>
