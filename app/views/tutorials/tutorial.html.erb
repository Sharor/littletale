<main class="fable-public fable-public-document fable-public-tutorial" aria-labelledby="tutorial-title">
  <h1 id="tutorial-title"><%= t('activerecord.attributes.tutorial.tutorial') %></h1>
  <span class="fable-public-flourish" aria-hidden="true">❧</span>
  <div class="fable-public-document-actions">
    <%= button_to t('activerecord.attributes.tutorial.continue'), tutorial_complete_path, class: "fable-public-button", method: :post %>
  </div>
</main>
