<main class="mx-auto max-w-6xl space-y-6">
  <header>
    <p class="text-sm uppercase tracking-widest text-cyan-300"><%= t("admin.users.eyebrow") %></p>
    <h1 class="mt-2"><%= t("admin.users.title") %></h1>
    <p class="mt-3 text-gray-500"><%= t("admin.users.introduction") %></p>
  </header>

  <%= form_with url: admin_users_path, method: :get, class: "fable-panel grid gap-3 sm:grid-cols-[1fr_auto]", role: "search" do |form| %>
    <div>
      <%= form.label :query, t("admin.users.search_label"), class: "fable-form-label block" %>
      <%= form.search_field :query, value: @query, placeholder: t("admin.users.search_placeholder"), class: "mt-2 w-full" %>
    </div>
    <%= form.submit t("admin.users.search"), class: "self-end min-h-11" %>
  <% end %>

  <section aria-labelledby="user-results-heading">
    <h2 id="user-results-heading" class="text-2xl"><%= t("admin.users.results") %></h2>
    <% if @users.empty? %>
      <p class="fable-panel mt-4"><%= t("admin.users.empty") %></p>
    <% else %>
      <div class="mt-4 overflow-x-auto rounded border bg-black/20">
        <table class="w-full text-left">
          <thead>
            <tr>
              <th class="p-4"><%= t("admin.dashboard.user") %></th>
              <th class="p-4"><%= t("admin.dashboard.status") %></th>
              <th class="p-4"><%= t("admin.dashboard.books_available") %></th>
              <th class="p-4"><%= t("admin.dashboard.character_credits") %></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr data-user-id="<%= user.id %>">
                <td class="p-4"><%= link_to user.email, admin_user_path(user), class: "underline" %></td>
                <td class="p-4"><%= user.paid? ? user.tier.capitalize : user.trial_status.humanize %></td>
                <td class="p-4" data-admin-book-credits="<%= user.available_book_credits if user.paid? %>">
                  <%= user.paid? ? user.available_book_credits : user.trial_books_remaining %>
                </td>
                <td class="p-4" data-admin-character-credits="<%= user.available_character_credits if user.paid? %>">
                  <%= user.paid? ? user.available_character_credits : t("admin.dashboard.trial_allowance") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</main>
