<main class="max-w-6xl mx-auto text-white">
  <h1 class="text-3xl font-bold mb-6"><%= t("admin.failed_books.title") %></h1>

  <% if @books.any? %>
    <div class="space-y-6">
      <% @books.each do |book| %>
        <article class="rounded-lg border border-red-300/30 bg-black/20 p-5">
          <% access_type = book.generation_failure["account_access"] || book.user.access_type %>
          <% reservation = book.trial_book_reservations.held.order(:id).last %>
          <% paid_reservation = book.book_credit_reservations.held.order(:id).last %>
          <% reservation ||= paid_reservation %>
          <h2 class="text-xl font-semibold"><%= book.name %></h2>
          <p class="text-sm text-gray-300"><%= t("admin.failed_books.owner") %>: <%= book.user.email %> · <%= t("admin.failed_books.failed") %>: <%= book.generation_failed_at %></p>
          <p class="mt-2 text-sm" data-account-access="<%= access_type %>">
            <%= t("admin.failed_books.account") %>: <strong><%= access_type.capitalize %></strong>
          </p>
          <% if reservation %>
            <% if book.illustration_retry_in_progress? %>
              <p class="mt-3 text-sm text-amber-200" data-quota-status="retrying">
                <%= t(paid_reservation ? "admin.failed_books.paid_reserved_retry" : "admin.failed_books.trial_reserved_retry") %>
              </p>
            <% else %>
              <div class="mt-3 flex flex-wrap items-center gap-3" data-quota-status="held">
                <p class="text-sm text-amber-200">
                  <% if paid_reservation %>
                    <%= t("admin.failed_books.paid_reserved", count: book.user.available_book_credits) %>
                  <% else %>
                    <%= t("admin.failed_books.trial_reserved", count: book.user.trial_books_remaining) %>
                  <% end %>
                </p>
                <%= button_to t(paid_reservation ? "admin.failed_books.release_credit" : "admin.failed_books.release_slot"),
                  release_trial_slot_admin_book_path(book), method: :post,
                  class: "rounded border border-amber-300/50 px-3 py-2 text-sm text-amber-100 hover:border-amber-200" %>
              </div>
            <% end %>
          <% elsif access_type == "trial" %>
            <p class="mt-3 text-sm text-gray-300" data-quota-status="released"><%= t("admin.failed_books.slot_released") %></p>
          <% end %>
          <p class="mt-3"><%= book.generation_failure["message"] %></p>
          <% book.current_pages.order(:id).each_with_index do |page, index| %>
            <% if page.illustration && page.illustration.original_image.blank? %>
              <div class="mt-4">
                <p><%= t("admin.failed_books.page_unavailable", page: index + 1) %></p>
                <%= render "books/illustration_controls", page: page, actor: current_user %>
                <details class="mt-2">
                  <summary><%= t("admin.failed_books.attempt_history") %></summary>
                  <pre class="overflow-x-auto text-xs"><%= JSON.pretty_generate(PageIllustrationGeneration.attempts(page.illustration)) %></pre>
                </details>
              </div>
            <% end %>
          <% end %>
          <pre class="mt-4 overflow-x-auto text-xs text-gray-300"><%= JSON.pretty_generate(book.generation_failure) %></pre>
        </article>
      <% end %>
    </div>
  <% else %>
    <p><%= t("admin.failed_books.none") %></p>
  <% end %>
</main>
