<main class="mx-auto max-w-6xl text-white">
  <p class="text-sm uppercase tracking-widest text-cyan-300"><%= t("admin.dashboard.eyebrow") %></p>
  <h1 class="mt-2 text-4xl font-bold"><%= t("admin.dashboard.title") %></h1>
  <p class="mt-3 text-gray-300"><%= t("admin.dashboard.introduction") %></p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <% [[t("admin.dashboard.reviews"), t("admin.dashboard.reviews_description", count: @reviews), admin_character_image_assessments_path], [t("admin.dashboard.failures"), t("admin.dashboard.failures_description", count: @failed_books), admin_failed_books_path], [t("admin.dashboard.jobs"), t("admin.dashboard.jobs_description"), "/jobs"], [t("admin.dashboard.console"), t("admin.dashboard.console_description"), "/console"]].each do |title, description, path| %>
      <%= link_to path, class: "block rounded-xl border border-white/20 bg-black/20 p-6 hover:border-cyan-300 focus-visible:outline focus-visible:outline-cyan-300" do %>
        <h2 class="text-xl font-semibold"><%= title %> →</h2>
        <p class="mt-3 text-gray-300"><%= description %></p>
      <% end %>
    <% end %>
  </div>

  <section class="fable-panel mt-10" aria-labelledby="generation-provider-heading"
    data-generation-provider data-provider-mode="<%= @generation_provider_setting.mode %>"
    data-active-provider="<%= @generation_provider_setting.provider %>">
    <div class="max-w-3xl">
      <p class="text-sm uppercase tracking-widest text-cyan-300"><%= t("admin.generation_provider.eyebrow") %></p>
      <h2 id="generation-provider-heading" class="mt-2 text-2xl"><%= t("admin.generation_provider.title") %></h2>
      <p class="mt-2 text-gray-500"><%= t("admin.generation_provider.introduction") %></p>
    </div>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded border bg-black/20 p-4">
        <dt class="text-sm text-gray-500"><%= t("admin.generation_provider.selected_mode") %></dt>
        <dd class="mt-1 text-lg font-semibold"><%= t("admin.generation_provider.modes.#{@generation_provider_setting.mode}.title") %></dd>
      </div>
      <div class="rounded border bg-black/20 p-4">
        <dt class="text-sm text-gray-500"><%= t("admin.generation_provider.active_provider") %></dt>
        <dd class="mt-1 text-lg font-semibold"><%= t("admin.generation_provider.modes.#{@generation_provider_setting.provider}.title") %></dd>
      </div>
      <div class="rounded border bg-black/20 p-4 sm:col-span-2" data-provider-window>
        <dt class="text-sm text-gray-500"><%= t("admin.generation_provider.window") %></dt>
        <dd class="mt-1 text-lg font-semibold"><%= t("admin.generation_provider.window_summary",
          failures: @generation_provider_failures, observations: @generation_provider_window.length,
          size: GenerationProviderSetting::WINDOW_SIZE) %></dd>
      </div>
    </dl>

    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <div class="rounded border bg-black/20 p-4" data-provider-switch-reason>
        <h3 class="text-lg"><%= t("admin.generation_provider.switch_audit") %></h3>
        <% if @generation_provider_setting.switch_reason.present? %>
          <p class="mt-2"><%= @generation_provider_setting.switch_reason.humanize %></p>
          <% if @generation_provider_setting.switched_at %>
            <time class="mt-1 block text-sm text-gray-500" datetime="<%= @generation_provider_setting.switched_at.iso8601 %>">
              <%= t("admin.generation_provider.switched_at", time: l(@generation_provider_setting.switched_at, format: :short)) %>
            </time>
          <% end %>
        <% else %>
          <p class="mt-2 text-gray-500"><%= t("admin.generation_provider.never_switched") %></p>
        <% end %>
      </div>
      <div class="rounded border bg-black/20 p-4">
        <h3 class="text-lg"><%= t("admin.generation_provider.credentials") %></h3>
        <ul class="mt-2 space-y-2">
          <% @generation_provider_credentials.each do |provider, configured| %>
            <li class="flex items-center justify-between gap-3" data-provider-credential="<%= provider %>"
              data-configured="<%= configured %>">
              <span><%= t("admin.generation_provider.modes.#{provider}.title") %></span>
              <strong><%= t("admin.generation_provider.#{configured ? "configured" : "missing"}") %></strong>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <%= form_with url: admin_generation_provider_path, method: :patch, class: "mt-6" do %>
      <fieldset>
        <legend class="fable-form-legend"><%= t("admin.generation_provider.selected_mode") %></legend>
        <div class="grid gap-3 md:grid-cols-3">
          <% GenerationProviderSetting::MODES.each do |mode| %>
            <label class="relative block cursor-pointer">
              <%= radio_button_tag :mode, mode, @generation_provider_setting.mode == mode, class: "peer sr-only" %>
              <span class="block min-h-full rounded border bg-black/20 p-4">
                <strong class="block"><%= t("admin.generation_provider.modes.#{mode}.title") %></strong>
                <span class="mt-1 block text-sm text-gray-500"><%= t("admin.generation_provider.modes.#{mode}.description") %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <%= submit_tag t("admin.generation_provider.save"), class: "mt-4",
        data: { turbo_submits_with: t("admin.generation_provider.saving") } %>
    <% end %>
  </section>

  <section class="fable-panel mt-10" aria-labelledby="production-health-heading" data-health-checks>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="max-w-2xl">
        <p class="text-sm uppercase tracking-widest text-cyan-300"><%= t("admin.health.eyebrow") %></p>
        <h2 id="production-health-heading" class="mt-2 text-2xl"><%= t("admin.health.title") %></h2>
        <p class="mt-2 text-gray-500"><%= t("admin.health.introduction") %></p>
      </div>
      <%= button_to t("admin.health.run_checks"), admin_health_check_path, method: :post,
        class: "min-h-11",
        data: { turbo_submits_with: t("admin.health.running") } %>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% [["object_storage", t("admin.health.object_storage.title"), t("admin.health.object_storage.description")], ["openai", t("admin.health.openai.title"), t("admin.health.openai.description")], ["gemini", t("admin.health.gemini.title"), t("admin.health.gemini.description")]].each do |name, title, description| %>
        <% check = @health_check_results[name] %>
        <% status = check&.fetch("status", nil) || "not_checked" %>
        <% status_classes = { "connected" => "border-green-700 bg-green-950/40", "failed" => "border-red-700 bg-red-950/40", "not_configured" => "border-amber-700 bg-amber-950/40", "not_checked" => "border-white/20 bg-black/20" } %>
        <article class="border p-5 <%= status_classes.fetch(status, status_classes.fetch("failed")) %>"
          data-health-check="<%= name %>" data-health-status="<%= status %>">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="text-xl"><%= title %></h3>
            <span class="rounded-full border px-3 py-1 text-sm font-semibold"><%= t("admin.health.statuses.#{status}") %></span>
          </div>
          <p class="mt-3 text-gray-500"><%= description %></p>
          <p class="mt-3"><%= check ? check.fetch("message") : t("admin.health.not_checked_description") %></p>
          <% if check %>
            <time class="mt-3 block text-sm text-gray-500" datetime="<%= check.fetch("checked_at") %>">
              <%= t("admin.health.checked", time: l(Time.iso8601(check.fetch("checked_at")), format: :short), duration: check.fetch("duration_ms")) %>
            </time>
          <% end %>
        </article>
      <% end %>
    </div>

    <div class="mt-6 border-t pt-6">
      <h3 class="text-xl"><%= t("admin.health.email.title") %></h3>
      <p class="mt-2 text-gray-500"><%= t("admin.health.email.description", email: current_user.email) %></p>
      <%= button_to t("admin.health.email.send"), admin_test_email_path, method: :post,
        class: "mt-4 min-h-11",
        data: { turbo_submits_with: t("admin.health.email.sending") } %>
    </div>
  </section>

  <section class="mt-10" aria-labelledby="user-access-heading">
    <h2 id="user-access-heading" class="text-2xl font-semibold"><%= t("admin.dashboard.user_access") %></h2>
    <div class="mt-4 overflow-x-auto rounded-xl border border-white/20 bg-black/20">
      <table class="w-full text-left">
        <thead class="border-b border-white/20 text-sm uppercase tracking-wide text-gray-300">
          <tr>
            <th class="p-4"><%= t("admin.dashboard.user") %></th>
            <th class="p-4"><%= t("admin.dashboard.status") %></th>
            <th class="p-4"><%= t("admin.dashboard.books_available") %></th>
            <th class="p-4"><%= t("admin.dashboard.character_credits") %></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="border-b border-white/10 last:border-0" data-user-id="<%= user.id %>">
              <td class="p-4"><%= user.email %></td>
              <td class="p-4"><%= user.paid? ? user.tier.capitalize : user.trial_status.humanize %></td>
              <td class="p-4" data-admin-book-credits="<%= user.available_book_credits if user.paid? %>">
                <%= user.paid? ? user.available_book_credits : user.trial_books_remaining %>
              </td>
              <td class="p-4" data-admin-character-credits="<%= user.available_character_credits if user.paid? %>">
                <%= user.paid? ? user.available_character_credits : t("admin.dashboard.trial_allowance") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
