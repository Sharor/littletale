<main class="max-w-6xl mx-auto text-white">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="mb-2 text-sm text-gray-300"><%= link_to t("admin.navigation.console"), console_path, class: "underline hover:text-white" %></p>
      <h1 class="text-3xl font-bold"><%= t("admin.reviews.title") %></h1>
    </div>

    <%= form_with url: admin_character_image_assessments_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div>
        <%= form.label :status, t("admin.reviews.status"), class: "block text-sm font-medium text-gray-200" %>
        <%= form.select :status,
          options_for_select([ [ t("admin.reviews.needs_review"), "needs_review" ], [ t("admin.reviews.rejected"), "rejected" ], [ t("admin.reviews.approved"), "approved" ], [ t("admin.reviews.unavailable"), "unavailable" ] ], @status),
          {}, class: "mt-1 rounded border border-white/20 bg-gray-900 px-3 py-2 text-white" %>
      </div>
      <div>
        <%= form.label :user_id, t("admin.reviews.owner_id"), class: "block text-sm font-medium text-gray-200" %>
        <%= form.number_field :user_id, value: @user_id, min: 1,
          class: "mt-1 w-32 rounded border border-white/20 bg-gray-900 px-3 py-2 text-white" %>
      </div>
      <%= form.submit t("admin.reviews.filter"), class: "rounded bg-cyan-700 px-4 py-2 font-semibold text-white hover:bg-cyan-600" %>
    <% end %>
  </div>

  <nav aria-label="Review status" class="mb-6 flex flex-wrap gap-3 text-sm">
    <% [ [ t("admin.reviews.needs_review"), "needs_review" ], [ t("admin.reviews.rejected"), "rejected" ], [ t("admin.reviews.approved"), "approved" ], [ t("admin.reviews.unavailable"), "unavailable" ] ].each do |label, status| %>
      <%= link_to label,
        admin_character_image_assessments_path(status: status, user_id: @user_id),
        class: "rounded border border-white/20 px-3 py-2 #{'bg-white/20' if @status == status}",
        aria: { current: @status == status ? "page" : nil } %>
    <% end %>
  </nav>

  <% if @assessments.any? %>
    <div class="space-y-4">
      <% @assessments.each do |assessment| %>
        <% provider_rejected = assessment.requests.any?(&:provider_rejected?) %>
        <article data-assessment-id="<%= assessment.id %>" class="rounded-lg border border-white/20 bg-black/20 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-xl font-semibold">
                <%= link_to t("admin.reviews.assessment", id: assessment.id), admin_character_image_assessment_path(assessment), class: "underline hover:text-cyan-200" %>
              </h2>
              <p class="mt-1 text-sm text-gray-300"><%= t("admin.failed_books.owner") %>: <%= assessment.user.email %> (ID <%= assessment.user_id %>)</p>
            </div>
            <p class="rounded bg-white/10 px-3 py-1 text-sm"><%= provider_rejected ? t("admin.reviews.provider_rejected") : t("admin.reviews.#{assessment.status}", default: assessment.status.humanize) %></p>
          </div>
          <p class="mt-3 line-clamp-2"><%= assessment.prompt %></p>
          <p class="mt-2 text-sm text-gray-300">
            <%= t(assessment.photo.attached? ? "admin.reviews.photo_request" : "admin.reviews.description_request") %>
            · <%= assessment.generation_model %>
            · <%= assessment.created_at %>
          </p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p><%= t("admin.reviews.none") %></p>
  <% end %>
</main>
