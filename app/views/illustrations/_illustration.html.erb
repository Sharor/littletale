<%# app/views/characters/_illustration.html.erb %>
<div id="illustration_section_<%= character.id %>">
  <% if character.completed? && character.illustration.present? %>
    <%= image_tag character.illustration.original_image.url, 
                  class: "w-full h-full object-contain block fade-in" %>
  <% elsif character.in_progress? %>
    <div class="w-full h-full aspect-[3/3] bg-gray-800 flex flex-col items-center justify-center space-y-3 ">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-cyan-500"></div>
      <p class="text-cyan-500 text-xs font-medium animate-pulse ">Generating...</p>
    </div>

  <% else %>
    <div class="w-full h-full aspect-[3/3] bg-gray-700 flex items-center justify-center">
      <p class="text-gray-400 text-xs">Waiting to start...</p>
    </div>
  <% end %>
</div>