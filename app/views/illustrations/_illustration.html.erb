<div id="illustration_section_<%= character.id %>" class="relative w-full aspect-square" role="status" aria-live="polite">
  <div class="absolute inset-0 overflow-auto">
    <% request = character.current_image_request %>
    <% state = request&.screening_status %>
    <% if state == "rejected" %>
      <div class="rounded-lg bg-red-950 p-4 text-sm text-red-100">
        <p><%= t("illustrations.rejected", reason: request.public_reason) %></p>
        <%= link_to t("illustrations.edit"), edit_character_path(character), class: "underline", data: { turbo_frame: "_top" }, onclick: "event.stopPropagation();" %>
      </div>
    <% elsif state == "needs_review" %>
      <p class="rounded-lg bg-amber-950 p-4 text-sm text-amber-100"><%= t("illustrations.needs_review") %></p>
    <% elsif state == "unavailable" %>
      <p class="p-4 text-sm text-amber-100"><%= t("illustrations.unavailable") %></p>
    <% elsif state == "checking" %>
      <p class="p-4 text-sm text-cyan-300"><%= t("illustrations.checking") %></p>
    <% elsif request&.generation_attempt&.status == "outcome_unknown" %>
      <p class="p-4 text-sm text-amber-100"><%= t("illustrations.outcome_unknown") %></p>
    <% elsif character.failed? %>
      <p class="p-4 text-sm text-red-200"><%= t("illustrations.failed") %></p>
    <% elsif character.completed? && character.illustration&.original_image&.present? %>
      <%= image_tag character.illustration.original_image.url, alt: character.name,
        class: "w-full h-full object-contain block fade-in" %>
    <% elsif character.in_progress? %>
      <p class="p-4 text-sm text-cyan-300"><%= t("illustrations.generating") %></p>
    <% elsif state == "approved" && request.generation_attempt.nil? %>
      <p class="p-4 text-sm text-amber-100"><%= t("illustrations.allowance_reached") %></p>
    <% else %>
      <p class="p-4 text-sm text-gray-400"><%= t("illustrations.waiting") %></p>
    <% end %>
  </div>
</div>
