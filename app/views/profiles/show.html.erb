<% content_for :body_class, "library-page" %>

<div class="<%= params[:onboarding].present? ? "profile-onboarding min-h-screen flex justify-center px-6 py-12" : "fable-layout" %>">
  <%= render "layouts/sidebar" unless params[:onboarding].present? %>

  <main class="fable-main fable-ui <%= "w-full max-w-3xl" if params[:onboarding].present? %>" id="main">
    <p class="text-sm uppercase tracking-widest text-cyan-300"><%= t("profile.eyebrow") %></p>
    <h1 class="mt-2 text-4xl font-bold"><%= t("profile.title") %></h1>
    <p class="mt-3 max-w-2xl text-gray-300"><%= t("profile.introduction") %></p>

    <%= form_with model: current_user, url: profile_path, method: :patch,
      class: "mt-8 max-w-2xl rounded-xl border border-white/20 bg-black/20 p-6 space-y-6" do |form| %>
      <%= hidden_field_tag :onboarding, true if params[:onboarding].present? %>

      <% if current_user.errors.any? %>
        <div role="alert" class="rounded border border-red-300/40 bg-red-950/40 p-3 text-red-100">
          <ul>
            <% current_user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :language, t("profile.language.label"), class: "block font-semibold" %>
        <p class="mt-1 text-sm text-gray-400"><%= t("profile.language.hint") %></p>
        <%= form.select :language, User::SUPPORTED_LANGUAGES.map { |code, name| [name, code] },
          { include_blank: current_user.language.blank? && t("profile.language.choose") },
          class: "mt-2 w-full rounded bg-gray-800 p-3 text-white" %>
      </div>

      <div>
        <%= form.label :reader_age, t("profile.reader_age.label"), class: "block font-semibold" %>
        <p class="mt-1 text-sm text-gray-400"><%= t("profile.reader_age.hint") %></p>
        <%= form.number_field :reader_age, min: 0, max: 120,
          class: "mt-2 w-full rounded bg-gray-800 p-3 text-white" %>
      </div>

      <% parent_restricted_enabled = @parent_control&.enabled? || false %>
      <section class="parent-restricted-setting <%= "parent-restricted-setting--disabled" unless parent_restricted_enabled %>"
        aria-labelledby="parent-restricted-heading"
        data-controller="parent-restriction"
        data-parent-restriction-initial-enabled-value="<%= parent_restricted_enabled %>"
        data-parent-restriction-on-label-value="<%= t("profile.parent_control.on") %>"
        data-parent-restriction-off-label-value="<%= t("profile.parent_control.off") %>">
        <div class="parent-restricted-setting__heading">
          <div>
            <p class="fable-character-eyebrow"><%= t("profile.parent_control.eyebrow") %></p>
            <h2 id="parent-restricted-heading"><%= t("profile.parent_control.title") %></h2>
          </div>
          <div class="parent-restricted-switch">
            <span class="parent-restricted-switch__status" data-parent-restriction-target="status">
              <%= t(parent_restricted_enabled ? "profile.parent_control.on" : "profile.parent_control.off") %>
            </span>
            <%= hidden_field_tag "user[parent_restricted_mode]", "0" %>
            <label class="parent-restricted-switch__control">
              <span class="sr-only"><%= t("profile.parent_control.toggle") %></span>
              <%= check_box_tag "user[parent_restricted_mode]", "1", parent_restricted_enabled,
                class: "parent-restricted-switch__input", role: "switch",
                data: { parent_restriction_target: "toggle", action: "change->parent-restriction#toggle" },
                aria: { describedby: "parent-restricted-explanation" } %>
              <span class="parent-restricted-switch__track" aria-hidden="true">
                <span class="parent-restricted-switch__thumb"></span>
              </span>
            </label>
          </div>
        </div>
        <p id="parent-restricted-explanation" data-parent-restricted-explanation>
          <%= t("profile.parent_control.explanation") %>
        </p>

        <% if @parent_control.nil? %>
          <div class="parent-restricted-setting__pin-grid">
            <div>
              <%= label_tag "user_parent_pin", t("profile.parent_control.new_pin"), class: "fable-form-label" %>
              <%= password_field_tag "user[parent_pin]", nil, id: "user_parent_pin", inputmode: "numeric",
                autocomplete: "new-password", minlength: 4, maxlength: 8 %>
            </div>
            <div>
              <%= label_tag "user_parent_pin_confirmation", t("profile.parent_control.confirm_pin"), class: "fable-form-label" %>
              <%= password_field_tag "user[parent_pin_confirmation]", nil, id: "user_parent_pin_confirmation",
                inputmode: "numeric", autocomplete: "new-password", minlength: 4, maxlength: 8 %>
            </div>
          </div>
          <p class="parent-restricted-setting__hint"><%= t("profile.parent_control.setup_hint") %></p>
        <% else %>
          <p class="parent-restricted-setting__hint"><%= t("profile.parent_control.change_hint") %></p>
          <div class="parent-restricted-setting__actions">
            <% if @parent_control.enabled? %>
              <%= link_to t("profile.parent_control.open_dashboard"), parent_path %>
            <% end %>
            <%= link_to t("profile.parent_control.forgot_pin"), new_parent_pin_reset_path %>
          </div>

          <dialog class="fable-ui parent-restricted-dialog" aria-labelledby="parent-restricted-dialog-title"
            data-parent-restriction-target="dialog"
            data-action="cancel->parent-restriction#cancel click->parent-restriction#closeOnBackdrop">
            <div class="parent-restricted-dialog__heading">
              <h3 id="parent-restricted-dialog-title"><%= t("profile.parent_control.dialog_title") %></h3>
              <button type="button" class="fable-dialog-close" aria-label="<%= t("common.close") %>"
                data-action="parent-restriction#cancel">×</button>
            </div>
            <p><%= t("profile.parent_control.dialog_explanation") %></p>
            <div class="parent-restricted-dialog__pin">
              <%= label_tag "user_current_parent_pin", t("profile.parent_control.current_pin"), class: "fable-form-label" %>
              <%= password_field_tag "user[current_parent_pin]", nil, id: "user_current_parent_pin",
                inputmode: "numeric", autocomplete: "current-password", minlength: 4, maxlength: 8,
                data: { parent_restriction_target: "pin" } %>
            </div>
            <div class="parent-restricted-dialog__actions">
              <button type="button" class="bg-gray-700" data-action="parent-restriction#cancel">
                <%= t("common.cancel") %>
              </button>
              <button type="button" data-action="parent-restriction#confirm">
                <%= t("profile.parent_control.confirm_change") %>
              </button>
            </div>
          </dialog>
        <% end %>
      </section>

      <%= form.submit t(params[:onboarding].present? ? "profile.continue" : "profile.save"),
        class: "min-h-11 rounded bg-amber-500 px-5 py-3 font-semibold text-gray-950 hover:bg-amber-400" %>
    <% end %>
  </main>
</div>
