<% advisory = local_assigns[:reason] == "book_advisory" %>
<% character_only = local_assigns[:reason] == "character" %>
<% expired = local_assigns[:reason] == "expired" %>
<% purchase_pin_required = parental_purchase_pin_required? %>
<div class="fable-ui fable-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="payment-required-title">
  <div class="fable-dialog-shell max-w-lg">
    <div class="fable-dialog-inner text-center">
      <p class="text-sm uppercase tracking-widest text-amber-300"><%= t("settings.modal.eyebrow") %></p>
      <h2 id="payment-required-title" class="mt-2 text-3xl font-bold">
        <%= t(expired ? "settings.modal.expired" : (character_only ? "settings.modal.character_required" : (advisory ? "settings.modal.no_books" : "settings.modal.book_required"))) %>
      </h2>
      <p class="mt-4 text-gray-200">
        <%= t("settings.modal.explanation") %>
      </p>
      <div class="mt-6 <%= purchase_pin_required ? "grid justify-items-center gap-4" : "flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center" %>"
        data-parental-purchase-actions="<%= purchase_pin_required ? "stacked" : "inline" %>">
        <%= form_with url: settings_book_purchase_path, method: :post do |form| %>
          <%= render "shared/parental_purchase_pin", form: form,
            field_id: "modal-book-purchase-parent-pin" if purchase_pin_required %>
          <%= form.button t("settings.payment.buy"), type: :submit,
            class: "min-h-11 rounded bg-amber-500 px-5 py-3 font-semibold text-gray-950 hover:bg-amber-400" %>
        <% end %>
        <% if @subscription.nil? || @subscription.status == "pending" %>
          <% subscription_button_label = t(@subscription&.status == "pending" ? "settings.payment.resume" : "settings.payment.subscribe") %>
          <%= form_with url: settings_subscription_path, method: :post do |form| %>
            <%= render "shared/parental_purchase_pin", form: form,
              field_id: "modal-subscription-parent-pin" if purchase_pin_required %>
            <%= form.button subscription_button_label, type: :submit,
              class: "min-h-11 rounded border border-cyan-300 px-5 py-3 font-semibold text-white hover:bg-cyan-300/10" %>
          <% end %>
        <% end %>
        <% if advisory %>
          <%= link_to t("settings.modal.continue"), continue_path,
            class: "min-h-11 rounded border border-white/30 px-5 py-3 font-semibold text-white hover:border-amber-300" %>
        <% else %>
          <%= link_to t("settings.modal.back"), books_path,
            class: "min-h-11 rounded border border-white/30 px-5 py-3 font-semibold text-white hover:border-amber-300" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
