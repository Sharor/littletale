<% content_for :body_class, "library-page" %>

<div class="fable-layout">
  <%= render "layouts/sidebar" %>

  <main class="fable-main fable-ui" id="main">
    <p class="text-sm uppercase tracking-widest text-cyan-300">Account access</p>
    <h1 class="mt-2 text-4xl font-bold">Trial &amp; subscription</h1>

    <section class="mt-8 max-w-2xl rounded-xl border border-white/20 bg-black/20 p-6" aria-labelledby="trial-heading">
      <h2 id="trial-heading" class="text-2xl font-semibold">Your access</h2>

      <% if current_user.admin? %>
        <p class="mt-4 text-lg" data-trial-status="admin">Administrator</p>
        <p class="mt-2 text-gray-300">Administrator accounts are not subject to trial limits.</p>
      <% elsif current_user.paid? %>
        <p class="mt-4 text-lg" data-trial-status="paid">Basic access</p>
        <p class="mt-2 text-gray-300">Your reading access does not expire.</p>
        <p class="mt-4 text-xl" data-book-credits="<%= current_user.available_book_credits %>">
          <strong><%= pluralize(current_user.available_book_credits, "book credit") %></strong> available
        </p>
      <% else %>
        <% status_labels = { "not_started" => "Not started", "active" => "Active", "expired" => "Expired" } %>
        <p class="mt-4 text-lg" data-trial-status="<%= current_user.trial_status %>">
          Trial status: <strong><%= status_labels.fetch(current_user.trial_status) %></strong>
        </p>
        <p class="mt-2 text-gray-300" data-books-remaining="<%= current_user.trial_books_remaining %>">
          <strong><%= current_user.trial_books_remaining %> books available</strong> of 3 trial books.
        </p>

        <% if current_user.trial_started_at.present? %>
          <p class="mt-2 text-gray-300">Started <%= l(current_user.trial_started_at, format: :long) %>.</p>
          <p class="mt-2 text-gray-300">Access <%= current_user.trial_expired? ? "ended" : "ends" %> <%= l(current_user.trial_expires_at, format: :long) %>.</p>
        <% else %>
          <p class="mt-2 text-gray-300">Your one-month reading period begins when your first book finishes generating.</p>
        <% end %>
      <% end %>
    </section>

    <% unless current_user.admin? %>
      <section class="mt-6 max-w-2xl rounded-xl border border-amber-300/30 bg-black/20 p-6" aria-labelledby="payment-heading">
        <p class="text-sm uppercase tracking-widest text-amber-300">Payment options</p>
        <h2 id="payment-heading" class="mt-2 text-2xl font-semibold">Buy your next book</h2>
        <p class="mt-3 text-gray-200">Each purchase includes one book credit and five character generations.</p>
        <%= button_to "Buy one book credit", settings_book_purchase_path, method: :post,
          class: "mt-5 min-h-11 rounded bg-amber-500 px-5 py-3 font-semibold text-gray-950 hover:bg-amber-400" %>
        <button type="button" disabled class="mt-4 block cursor-not-allowed text-sm text-gray-400">Subscriptions coming soon</button>
      </section>

      <% if @purchases.any? %>
        <section class="mt-6 max-w-2xl rounded-xl border border-white/20 bg-black/20 p-6" aria-labelledby="purchase-history-heading">
          <h2 id="purchase-history-heading" class="text-2xl font-semibold">Purchase history</h2>
          <ul class="mt-4 space-y-3">
            <% @purchases.each do |purchase| %>
              <li class="flex flex-wrap justify-between gap-3 border-b border-white/10 pb-3 last:border-0">
                <span><%= l(purchase.created_at, format: :long) %></span>
                <span><%= purchase.status.humanize %><% if purchase.amount_total %> · <%= number_to_currency(purchase.amount_total / 100.0, unit: purchase.currency.to_s.upcase + " ") %><% end %></span>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    <% end %>
  </main>
</div>

<% if current_user.trial_expired? %>
  <%= render "payment_modal", reason: "expired" %>
<% elsif params[:payment_required].present? %>
  <%= render "payment_modal", reason: params[:payment_required] %>
<% end %>
