<div class="fable-layout">
  <%= render "layouts/sidebar" %>

  <main class="fable-main fable-ui">
    <h1 class="text-2xl font-bold mb-4">New Book</h1>

    <%= form_with model: @book, class: "fable-panel fable-book-form space-y-4" do |f| %>
      <% if @book.errors.any? %>
        <div role="alert" class="rounded border border-red-300/40 bg-red-950/40 p-3 text-red-100">
          <ul>
            <% @book.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block" %>
        <%= f.text_field :name, class: "bg-gray-800 text-white rounded p-2 w-full" %>
      </div>

      <div>
        <%= f.label :plot, class: "block" %>
        <%= f.text_area :plot, class: "bg-gray-800 text-white rounded p-2 w-full", rows: 5 %>
      </div>

   <% limit = @book.tier_limit %> 

  <div class="space-y-2">
    <%= f.label :total_pages, "Length of the Tale", class: "block font-semibold" %>
    
    <div class="flex flex-wrap items-center gap-4">
      <%= f.number_field :total_pages, 
          max: limit, 
          min: 1, 
          class: "w-24 bg-gray-900 border-gray-700 rounded text-center focus:ring-yellow-500",
          data: { action: "change->form#updateLimitHint" } %>
      
      <span class="text-sm text-gray-400">
        Max: <strong class="text-yellow-500"><%= limit %> pages</strong> 
        (<%= current_user.tier.capitalize %> Tier)
      </span>
    </div>

    <% if current_user.tier != "premium" %>
      <p class="text-xs italic text-blue-400">
        Want more? <a href="/pricing" class="underline">Upgrade for up to 20 pages!</a>
      </p>
    <% end %>
  </div>

      <% @book.character_ids.each do |id| %>
        <%= f.hidden_field :character_ids, multiple: true, value: id %>
      <% end %>

      <div>
        <%= f.submit "Create Book", class: "bg-blue-600 px-4 py-2 rounded cursor-pointer" %>
      </div>
    <% end %>
  </main>
</div>
