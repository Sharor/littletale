<div class="page" data-density="hard">
  <div class="page-content">
    <div class="page-text">
      <% if page.illustration.present? %>
        <%= image_tag page.illustration.original_image.url, class: "illustration" %>
      <% end %>
      
      <div class="story-body">
        <%= page.text %>
      </div>
    </div>
    <div class="page-footer mt-auto text-xs text-center"><%= index + 1 %></div>
  </div>
</div>