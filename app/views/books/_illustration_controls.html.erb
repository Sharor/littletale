<%= turbo_frame_tag dom_id(page, :illustration_controls) do %>
  <% if actor && page.illustration && page.illustration.original_image.blank? %>
    <% illustration = page.illustration %>
    <% attempts_used = PageIllustrationGeneration.attempts(illustration).length %>
    <% if PageIllustrationGeneration.available?(illustration, admin: actor) %>
      <% retry_path = actor.admin? ? regenerate_admin_page_illustration_path(illustration) : regenerate_illustration_page_path(page) %>
      <%= button_to "Regenerate illustration", retry_path,
        method: :post, data: { turbo_frame: "_top" },
        class: "rounded bg-amber-700 px-3 py-2 text-sm text-white" %>
    <% elsif %w[queued running].include?(PageIllustrationGeneration.state(illustration)["status"]) %>
      <p role="status">Illustration retry in progress.</p>
    <% elsif page.generation_attempt != page.book.generation_attempt %>
      <p>This page is no longer current.</p>
    <% end %>
    <p class="text-sm"><%= attempts_used %> of <%= PageIllustrationGeneration::MAX_ATTEMPTS %> attempts used</p>
  <% end %>
<% end %>
