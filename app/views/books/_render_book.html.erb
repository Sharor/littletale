<div class="book-container">
  <div id="storybook">
    <div class="page page-cover page-cover-top" data-density="hard">
    <div class="bookmark-ribbon"></div>
    <div class="page-content"> 
      <div class="flex flex-col items-center w-full">
        <div class="uppercase tracking-widest text-[10px] mb-2" style="color: #e2c275;"><%= t("books.reader.chronicles") %></div>
        <h1><%= book.name %></h1>
      </div>
      
      <% cover_page = book.current_pages.order(:id).to_a.reverse.find { |page| page.illustration&.original_image&.url.present? } %>
      <% if cover_page %>
        <div class="w-2/3 mt-4 border border-amber-900/30 p-1">
            <%= image_tag cover_page.illustration.original_image.url, class: "w-full object-contain" %>
        </div>
      <% end %>
    </div>
  </div>
    <% book.current_pages.order(:id).each_with_index do |page,index| %>
      <%= render "books/page", book: book, index: index, page: page %>
    <% end %>

    <div class="page page-cover page-cover-bottom" data-density="hard">
      <div class="page-content">
      <h2 class="mb-8"><%= t("books.reader.the_end") %></h2>
      <%= link_to t("books.reader.back_to_library"), books_path, class: "book-back-button" %>
      </div>
    </div>
  </div>

  
  
<div class="under-book-text">
    <p><%= t("books.reader.instructions") %></p>
  </div>
</div>

<div class="book-controls flex justify-between items-center bg-stone-900 shadow-2xl">
  <button id="prevPage" class="nav-arrow-btn flex-1 py-3 text-amber-200 uppercase tracking-tighter text-xs border-r border-amber-900/30">
    <svg class="w-4 h-4 mr-1 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
    <%= t("books.reader.previous") %>
  </button>
  
  <button id="nextPage" class="nav-arrow-btn flex-1 py-3 text-amber-200 uppercase tracking-tighter text-xs">
    <%= t("books.reader.next") %>
    <svg class="w-4 h-4 ml-1 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
  </button>
</div>
