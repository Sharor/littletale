<div id="<%= dom_id(book, :state) %>">
  <% if book.pending? %>
    <div class="fable-ui fable-book-status flex flex-col items-center py-10 text-center">
      <h1 class="text-3xl font-bold"><%= book.name %></h1>
      <div role="status" class="mt-6">
        <span aria-hidden="true" class="inline-block h-8 w-8 rounded-full border-4 border-yellow-200/20 border-t-yellow-300 motion-safe:animate-spin"></span>
        <p class="mt-4 text-lg">Getting your book ready…</p>
        <p class="mt-2 text-gray-300">Generation will begin shortly. This page will update automatically.</p>
      </div>
    </div>
  <% elsif book.generation_status == "in_progress" %>
    <h1 class="fable-reader-title text-3xl font-bold text-center"><%= book.name %></h1>
    <% wardrobe = book.current_wardrobe_plan %>
    <% if wardrobe && !wardrobe.ready? %>
      <p role="status" class="text-center mt-4">Preparing the story and character outfits…</p>
    <% end %>
    <%= render "books/castle", book: book %>
  <% elsif book.failed? && book.generation_failure["type"] == "character_image_not_ready" %>
    <p role="status" class="fable-notice p-4 text-amber-100"><%= book.generation_failure["message"] %></p>
    <%= link_to "Review character images", characters_path, class: "underline" %>
  <% elsif book.failed? && book.generation_failure["type"].to_s.start_with?("wardrobe_") %>
    <p role="status" class="fable-notice p-4 text-amber-100"><%= book.generation_failure["message"] %></p>
  <% elsif book.failed? %>
    <p role="status" class="fable-notice p-4 text-amber-100">
      This book is incomplete. Generation stopped before all illustrations were ready.
      <% if book.generation_failure["type"] == "openai_image_moderation_blocked" %>
        The image provider declined an illustration request.
      <% end %>
      <% if book.current_pages.any? %>
        You can read the available story below. Missing illustrations are marked.
      <% end %>
    </p>
    <% if book.current_pages.any? %>
      <%= render "books/render_book", book: book %>
    <% end %>
  <% elsif book.generation_status == "completed" && book.current_pages.all?{|p| p.illustration&.original_image&.url&.present?} %>
    <div class="animate-magical-reveal text-lg text-gray-200">
      <%= render "books/render_book", book: book %>
    </div>
  <% end %>
</div>
