<%= turbo_frame_tag "book_characters" do %>
    <div class="grid grid-cols-4 gap-2 mt-7 w-full">
        <div class="text-center overflow-hidden shadow-lg rounded-lg min-h-65 flex items-center justify-center" >
            <div>
            <%= button_to t('activerecord.attributes.characters.new'), new_character_path , class: "fantasy-button #{@tutorial}", method: :get, params: { book_id: book.id, path: book }, form: { data: { turbo_frame: "_top" } }  %>
            <%= turbo_frame_tag "character_modal" %>
            <% disabled = current_user.characters.none? %>
            <%= button_to t('activerecord.attributes.characters.existing'), select_characters_path, class: "fantasy-button reuse_character #{'opacity-50 cursor-not-allowed' if disabled}",
            method: :get, params: { book_id: book.id }, data: { turbo_frame: "character_select_modal" }, disabled: disabled  %>
            </div>
        </div>
        <% if book.characters.none? %>
            <div class="col-span-3 character_generation_area"></div>
        <% end %>
        <% book.characters.each do |character| %>
          <div class="text-center overflow-hidden shadow-lg rounded-lg h-auto">
            <%= render "illustrations/illustration", character: character %>
            <%= link_to character.name, edit_character_path(character, book_id: book.id), data: { turbo_frame: "_top" } %>
          </div>
        <% end %>
    </div>
<% end %>
