<%= turbo_frame_tag "book_modal" do %>
<div aria-labelledby="modal-title"
    aria-modal="true" class="w-full overflow-y-auto fixed inset-0 z-50 bg-black/80" role="dialog">
    <div class="parchment h-screen w-2/4 mx-auto flex  justify-center">
      <div class=" max-w-3xl p-12 bg-transparent min-w-[600px] animate-fade-in-up">
        <div class="grid grid-cols-3 ">
          <h1 id="modal-title" class="col-start-2 font-extrabold text-2xl">The plot of your story</h1>
          <%= link_to "\u{274C}", book_path(@book), class: 'mb-14' %>
        </div>
        
          <%= render "form", book: @book %>
        
      </div>
    </div>
  </div>
<% end %>