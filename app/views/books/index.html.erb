<% content_for :body_class, "library-page" %>

<div class="library-layout">
  <%= render "layouts/sidebar" %>

  <main class="library-main">
    <header class="library-heading">
      <p class="library-eyebrow"><%= t("books.index.eyebrow") %></p>
      <h1><%= t("books.index.title") %></h1>
      <div class="library-rule" aria-hidden="true"><span>✦</span></div>
    </header>

    <div class="library-grid">
      <% if current_user.book_generation_available? %>
        <%= link_to characters_path, class: "library-create #{@tutorial}" do %>
          <span class="library-create-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M32 17C24 12 14 12 6 15v36c8-3 18-3 26 2 8-5 18-5 26-2V15c-8-3-18-3-26 2Zm0 0v36M12 21c5-1 10 0 14 2m-14 6c5-1 10 0 14 2m-14 6c5-1 10 0 14 2M45 24v16m-8-8h16" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="library-create-label"><%= t("books.index.create") %></span>
          <span class="library-create-plus" aria-hidden="true">+</span>
        <% end %>
      <% else %>
        <div class="library-create opacity-60" data-new-book-disabled aria-disabled="true"
          title="<%= t("books.index.credit_required") %>">
        <span class="library-create-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M32 17C24 12 14 12 6 15v36c8-3 18-3 26 2 8-5 18-5 26-2V15c-8-3-18-3-26 2Zm0 0v36M12 21c5-1 10 0 14 2m-14 6c5-1 10 0 14 2m-14 6c5-1 10 0 14 2M45 24v16m-8-8h16" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="library-create-label"><%= t("books.index.create") %></span>
        <span class="library-create-plus" aria-hidden="true">+</span>
        </div>
      <% end %>

      <% @books.each do |book| %>
        <article class="library-book">
          <%= link_to book, class: "library-cover" do %>
            <span class="library-ribbon" aria-hidden="true"></span>
            <span class="library-cover-eyebrow" aria-hidden="true"><%= t("books.reader.chronicles") %></span>
            <span class="library-artwork">
              <% cover_image = book.current_pages.last&.illustration&.original_image %>
              <% if cover_image.present? %>
                <%= image_tag cover_image.url, alt: "", loading: "lazy", decoding: "async" %>
              <% else %>
                <span class="library-cover-emblem" aria-hidden="true">✦</span>
              <% end %>
            </span>
            <h3><%= book.name %></h3>
            <span class="library-cover-flourish" aria-hidden="true">❧</span>
          <% end %>
          <div class="library-book-actions">
            <%= link_to t("books.index.read"), book, class: "library-read", aria: { label: t("books.index.read_named", name: book.name) } %>
            <% if book.gift_preparable? %>
              <%= render "book_gifts/prepare_action",
                book: book,
                label: t("books.index.send_as_gift"),
                form_class: "library-gift-form",
                button_class: "library-gift-action",
                aria_label: t("books.index.send_as_gift_named", name: book.name) %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <% if @gifted_books.any? %>
      <section class="gifted-library" aria-labelledby="gifted-library-title">
        <header class="library-heading">
          <h2 id="gifted-library-title"><%= t("book_gifts.received.title") %></h2>
        </header>
        <div class="library-grid">
          <% @gifted_books.each do |gift| %>
            <article class="library-book">
              <%= link_to received_gift_path(gift), class: "library-cover" do %>
                <span class="library-ribbon" aria-hidden="true"></span>
                <span class="library-cover-eyebrow"><%= t("book_gifts.invitation.from", sender: gift.sender_callname) %></span>
                <span class="library-artwork"><span class="library-cover-emblem" aria-hidden="true">✦</span></span>
                <h3><%= gift.title %></h3>
                <span class="library-cover-flourish" aria-hidden="true">❧</span>
              <% end %>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  </main>
</div>
