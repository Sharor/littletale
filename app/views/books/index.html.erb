<%# 1. We remove h-screen completely from mobile to let the document scroll naturally %>
<div class="app-wrapper flex flex-col lg:flex-row text-white lg:h-screen overflow-x-hidden">
  
  <%# Ensure your sidebar isn't using 'fixed' or 'absolute' position on mobile %>
  <%= render "layouts/sidebar" %> 

  <%# 2. On mobile, we remove overflow-y-auto so the whole page scrolls %>
  <div class="p-4">
  <main class="flex-grow ">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-8 pb-2 border-b border-white/20">
      Current Library
    </h2>

    <%# 3. Added min-h-screen to ensure the grid has space, and pb-20 for thumb-room at bottom %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6 pb-20">
      
      <%= link_to characters_path, class: "group #{@tutorial} h-full" do %>
        <div class="rounded-xl p-4 frosted-glass flex flex-col items-center justify-center text-center border-2 border-dashed border-white/30 group-hover:border-cyan-400 transition h-full min-h-[250px] md:min-h-[350px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-cyan-400 mb-2 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span class="text-sm font-medium text-cyan-400">Make a new book</span>
        </div>
      <% end %>

      <% @books.each do |book| %>
        <%# flex-grow on the card ensures they take up equal height in a row %>
        <div class="rounded-xl p-2 frosted-glass flex flex-col items-center text-center h-full">
          
          <%= link_to book, class: "w-full flex-grow flex flex-col" do %>
            <div class="book-cover-frame rounded-lg overflow-hidden w-full aspect-[2/3] mb-3 relative shadow-lg">
              <div class="page page-cover page-cover-top h-full" data-density="hard">
                  <div class="flex flex-col items-center w-full h-full">
                    <% if book.pages.last&.illustration&.original_image&.present? %>
                      <%= image_tag book.pages.last.illustration.original_image.url, 
                                    class: "w-full h-full object-cover" %>
                    <% end %>
                </div>
              </div>
            </div>

            <h3 class="text-xs md:text-sm font-semibold line-clamp-2 w-full px-1 min-h-[2.5rem] flex items-center justify-center">
              <%= book.name %>
            </h3>
          <% end %>

          <%= link_to "Read", book, class: "mt-auto w-full py-2 text-xs bg-cyan-600 rounded-lg hover:bg-cyan-500 transition duration-150 font-bold" %>
        </div>
      <% end %>
      
    </div>
  </main>
  </div>
</div>