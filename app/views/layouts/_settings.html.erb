<section class="site-settings" aria-label="<%= t("navigation.settings") %>">
  <h4><%= t("navigation.settings") %></h4>
  <% if current_user&.admin? %>
    <%= link_to t("navigation.administration"), admin_root_path %>
  <% elsif current_user %>
    <%= link_to t("navigation.subscription"), settings_path %>
  <% end %>
  <% if current_user %>
    <%= link_to t("navigation.profile"), profile_path %>
    <% if current_user.parent_control&.enabled? %>
      <%= link_to t("navigation.parent_dashboard"), parent_path %>
    <% end %>
  <% end %>
</section>
