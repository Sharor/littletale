<!-- 1. LEFT SIDE NAVIGATION BAR (Sidebar) - FROSTED GLASS EFFECT -->
<aside class="site-sidebar w-full lg:w-64 mb-6 lg:mb-0 lg:mr-6 p-4 rounded-xl frosted-glass h-auto lg:h-[calc(100vh-3rem)] sticky top-6 self-start">
    <div class="site-brand text-2xl font-bold mb-8 text-cyan-300">
        <%= t("navigation.brand") %>
    </div>

    <nav class="space-y-3">
        <%= link_to books_path, class: "flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition duration-150 font-semibold bg-white/5 shadow-inner" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            <span><%= t("navigation.home") %></span>
        <% end %>
    </nav>
    <%= render "layouts/settings" %>
</aside>

<header class="site-mobile-header block lg:hidden w-full frosted-glass sticky top-0 z-50 border-b border-white/10 mb-4">
  <div class="flex items-center justify-between p-4">
    <div class="site-brand text-xl font-bold text-cyan-300">
      <%= t("navigation.brand") %>
    </div>
    
    <nav class="flex space-x-4">
      <%= link_to books_path, class: "p-2 text-gray-300 hover:text-cyan-300", aria: { label: t("navigation.home") } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
      <% end %>
      
    </nav>
  </div>
  
  <div class="site-mobile-tools">
  <%= render "layouts/settings" %>
  </div>
</header>
