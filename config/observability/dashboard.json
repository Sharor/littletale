{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" },
    { "name": "DS_LOKI", "label": "Loki", "type": "datasource", "pluginId": "loki", "pluginName": "Loki" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }, "id": 1,
      "targets": [{ "expr": "sum(rate(rails_http_requests_total[5m]))", "refId": "A" }],
      "title": "Request rate", "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }, "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(rails_http_request_duration_seconds_bucket[5m])))", "refId": "A" }],
      "title": "HTTP p95", "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }, "id": 3,
      "targets": [{ "expr": "sum(rate(rails_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(rails_http_requests_total[5m])), 0.001)", "refId": "A" }],
      "title": "HTTP error rate", "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }, "id": 4,
      "targets": [
        { "expr": "solid_queue_depth", "legendFormat": "ready", "refId": "A" },
        { "expr": "solid_queue_stuck_running_jobs", "legendFormat": "stuck", "refId": "B" },
        { "expr": "solid_queue_failed_jobs", "legendFormat": "failed", "refId": "C" }
      ],
      "title": "Jobs", "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }, "id": 5,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(rails_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(rails_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(rails_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "HTTP latency", "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }, "id": 6,
      "targets": [
        { "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "memory", "refId": "A" },
        { "expr": "1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}", "legendFormat": "disk {{mountpoint}}", "refId": "B" }
      ],
      "title": "Host capacity used", "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }, "id": 7,
      "targets": [{ "expr": "container_memory_working_set_bytes{name!=\"\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "Container memory", "type": "timeseries"
    },
    {
      "datasource": "${DS_LOKI}", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }, "id": 8,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{environment=\"production\", service=\"little_stories\"}", "refId": "A" }],
      "title": "Application logs", "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["little-tale", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Little Tale Production",
  "uid": "little-tale-production",
  "version": 1
}
